# LLM (Ollama default — port 8080 on this machine is used by Frigate)
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:7b
LLM_TEMPERATURE=0.8
LLM_MAX_TOKENS=512

# Chatterbox TTS Server (Docker — chatterbox-tts-server-cu128 on port 8004)
CHATTERBOX_BASE_URL=http://127.0.0.1:8004
CHATTERBOX_VOICE_MODE=clone
CHATTERBOX_PREDEFINED_VOICE=Olivia.wav
CHATTERBOX_REFERENCE_VOICE=kryten2.mp3
CHATTERBOX_TEMPERATURE=0.8
CHATTERBOX_EXAGGERATION=0.5
CHATTERBOX_CFG_WEIGHT=0.5

# Persona
BOT_NAME=ArgueBot
BOT_PERSONA_BLURB=Speaks with conviction, rhetorical flair, and argumentative energy.